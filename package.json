{
  "name": "japan-cinema-browser-mcp",
  "version": "0.1.0",
  "description": "A lightweight browser-first MCP server for Japanese cinema websites.",
  "type": "module",
  "bin": {
    "japan-cinema-browser-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "smoke:toho": "tsx tests/toho-live.smoke.ts",
    "smoke:aeon": "tsx tests/aeon-live.smoke.ts",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "chrome-remote-interface": "0.34.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "26.1.2",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cinema",
    "japan",
    "browser-automation",
    "chrome",
    "cdp"
  ],
  "license": "MIT"
}
