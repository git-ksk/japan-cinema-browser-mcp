# Optional: explicit Chrome executable path
# CINEMA_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: override dedicated profile directory
# CINEMA_CHROME_PROFILE_DIR=/Users/you/.japan-cinema-browser-mcp/chrome-profile

# Opt-in attachment to an already-running local Chrome CDP endpoint
# CINEMA_ALLOW_EXTERNAL_CDP=true
# CINEMA_CDP_PORT=9222

# Keep headed by default for user-visible authentication/handoffs
CINEMA_HEADLESS=false

# Bounded visible-text output
CINEMA_MAX_READ_CHARS=8000

# Consequential action gate
CINEMA_CONFIRMATION_TTL_SECONDS=120
CINEMA_ENABLE_PURCHASE=false

# --- Remote single-user Cloud Run mode (opt-in) ---
# CINEMA_REMOTE_MODE=true
# CINEMA_HEADLESS=true
# CINEMA_ENABLE_PURCHASE=false
# MCP_HTTP_HOST=0.0.0.0
# MCP_ALLOW_NONLOOPBACK=true
# ChatGPT/MCP OAuth resource-server boundary backed by Firebase Authentication
# MCP_ALLOWED_HOSTS=<exact-cloud-run-hostname>
# MCP_PUBLIC_BASE_URL=https://<exact-cloud-run-hostname>
# MCP_OAUTH_ALLOWED_CLIENT_HOSTS=chatgpt.com
# MCP_OAUTH_AUTHORIZATION_TTL_SECONDS=600
# MCP_OAUTH_CODE_TTL_SECONDS=120
# MCP_OAUTH_ACCESS_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TTL_DAYS=30
# MCP_OAUTH_CLIENT_METADATA_TIMEOUT_MS=5000
# MCP_FIREBASE_PROJECT_ID=<firebase-project-id>
# MCP_FIREBASE_WEB_API_KEY=<firebase-web-api-key>
# MCP_ALLOWED_FIREBASE_UIDS=<single-owner-uid>
# MCP_FIREBASE_LOOKUP_TIMEOUT_MS=5000
# MCP_MAX_BODY_BYTES=262144
# CINEMA_OPERATION_TIMEOUT_MS=30000

# Usage accounting/rate limiting is intentionally outside the OSS core runtime.
# Add it at your deployment boundary if needed.

# Only enable after a verified Chromium sandbox incompatibility in an isolated single-user runtime.
# CINEMA_ALLOW_UNSANDBOXED_CHROMIUM=false
