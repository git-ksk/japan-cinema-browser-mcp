# Optional: explicit Chrome executable path
# CINEMA_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: override dedicated profile directory
# CINEMA_CHROME_PROFILE_DIR=/Users/you/.japan-cinema-browser-mcp/chrome-profile

# Opt-in attachment to an already-running local Chrome CDP endpoint
# CINEMA_ALLOW_EXTERNAL_CDP=true
# CINEMA_CDP_PORT=9222

# Keep headed by default for user-visible authentication/handoffs
CINEMA_HEADLESS=false

# Bounded visible-text output
CINEMA_MAX_READ_CHARS=8000

# Consequential action gate
CINEMA_CONFIRMATION_TTL_SECONDS=120
CINEMA_ENABLE_PURCHASE=false
